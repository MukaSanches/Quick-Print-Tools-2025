<UserControl x:Class="QuickPrintStudio.Addon.Views.DockerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="280" MinHeight="420" Background="{DynamicResource QpsBackgroundBrush}" AutomationProperties.Name="Quick Print Studio">
 <UserControl.Resources>
  <SolidColorBrush x:Key="QpsBackgroundBrush" Color="#202124"/><SolidColorBrush x:Key="QpsSurfaceBrush" Color="#2B2D31"/><SolidColorBrush x:Key="QpsTextBrush" Color="#F4F4F5"/><SolidColorBrush x:Key="QpsMutedBrush" Color="#B7BAC1"/>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="KeyboardNavigation.IsTabStop" Value="True"/></Style>
 </UserControl.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="QUICK PRINT STUDIO" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource QpsTextBrush}"/><TextBlock Text="Produção gráfica assistida para CorelDRAW 2025" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{DynamicResource QpsMutedBrush}"/><TextBox x:Name="SearchBox" MinHeight="36" Padding="10,6" TextChanged="SearchBox_OnTextChanged" ToolTip="Digite o que você quer fazer. Ex.: marca de corte, medir banner, exportar PDF." AutomationProperties.Name="Buscar ferramenta"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource QpsSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,12"><StackPanel><TextBlock x:Name="DocumentNameText" Text="Nenhum documento aberto" FontWeight="SemiBold" Foreground="{DynamicResource QpsTextBrush}" TextWrapping="Wrap"/><TextBlock x:Name="DocumentMetaText" Text="Abra um documento para começar." Margin="0,4,0,0" Foreground="{DynamicResource QpsMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="AÇÕES PRINCIPAIS" Margin="0,4,0,6" FontWeight="SemiBold" Foreground="{DynamicResource QpsMutedBrush}"/><Button Content="Analisar documento" Click="Analyze_OnClick" ToolTip="Verifica cores, imagens, fontes e outros pontos que podem causar problemas na produção."/><Button Content="Preparar produção" IsEnabled="False" ToolTip="Assistente guiado para sangria, marcas, cores e outras etapas."/><Button Content="Fazer imposição" IsEnabled="False" ToolTip="Organiza várias cópias da arte na folha, respeitando margens e espaçamento."/><Button Content="Exportar" IsEnabled="False" ToolTip="Exporta o trabalho usando um preset de produção."/><TextBlock Text="RESULTADOS" Margin="0,16,0,6" FontWeight="SemiBold" Foreground="{DynamicResource QpsMutedBrush}"/><ItemsControl x:Name="ResultsList"/><TextBlock Text="FERRAMENTAS" Margin="0,16,0,6" FontWeight="SemiBold" Foreground="{DynamicResource QpsMutedBrush}"/><ItemsControl x:Name="SearchResults"/></StackPanel></ScrollViewer>
 </Grid>
</UserControl>